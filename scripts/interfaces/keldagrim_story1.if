[keldagrim_story1_line1]
type=Text
width=451
height=17
layerId=9895936
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="Five hundred years have passed since the rule of King Alvis,"

[keldagrim_story1_line2]
type=Text
y=1
width=451
height=18
layerId=9895937
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="saviour of Keldagrim, victim of his own inventions."

[keldagrim_story1_line3]
type=Text
width=450
height=16
layerId=9895938
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="Founder of the Consortium, the gathering of mining companies"

[keldagrim_story1_line4]
type=Text
y=1
width=450
height=17
layerId=9895939
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="that were to serve the monarchy, eventually the monarchy came"

[keldagrim_story1_line5]
type=Text
width=451
height=15
layerId=9895940
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="to serve the Consortium."

[keldagrim_story1_line6]
type=Text
width=452
height=15
layerId=9895941
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="By the time of his death, the monarchy was all but abolished."

[keldagrim_story1_line7]
type=Text
width=452
height=16
layerId=9895942
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="By now, the Kings of Keldagrim are but a distant memory..."

[keldagrim_story1_line8]
type=Text
y=1
width=453
height=18
layerId=9895943
colour=0xFF0000
hAlign=Center
font=b12_full
shadow=yes
text="with only the statue of King Alvis to remind the people of the"

[keldagrim_story1_line9]
