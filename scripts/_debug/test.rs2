[debugproc,test]
mes("Wow they work.");

[debugproc,givemc]
inv_add(inv, twpart1, 1);
inv_add(inv, twpart2, 1);
inv_add(inv, twpart3, 1);
inv_add(inv, twpart4, 1);
inv_add(inv, mcannonball, 1000);

[debugproc,anim](seq $anim)
if ($anim = null) {
    mes("Not found");
    return;
}
mes("Found");
anim($anim, 0);

[debugproc,cs2test](string $str)
if_opensub(skill_guide_v2, toplevel:main, 0);
def_namedobj $objId = 2dose2energy;
runclientscript("script24(1, $objId, 0, 0, $str)");
$objId = zogre_coffinkey;
runclientscript("script24(50, $objId, 1, 32, $str)");
$objId = potato_butter;
runclientscript("script24(99, $objId, 2, 64, $str)");