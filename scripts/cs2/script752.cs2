// 752
[clientscript,script752]
if (%varbit_4534 = 0 & %varbit_4290 = 0) {
	if_settext("---", lore_stats_side:animal_time_left);
	return;
}
if (%varbit_4290 = 0) {
	if_settext("<tostring(%varbit_4534)>.00", lore_stats_side:animal_time_left);
} else {
	if_settext("<tostring(%varbit_4534)>.30", lore_stats_side:animal_time_left);
}
