// 89
[proc,script89]
def_int $int0 = 0;
def_component $component1 = null;
def_int $int2 = 0;
def_int $int3 = 0;
if (reboottimer > 0) {
	$int2 = calc(reboottimer / 50 % 60);
	$int3 = calc(reboottimer / 3000);
	if ($int2 < 10) {
		if_settext("<col=ffff00>System update in: <tostring($int3)>:0<tostring($int2)>", toplevel:pm5);
	} else {
		if_settext("<col=ffff00>System update in: <tostring($int3)>:<tostring($int2)>", toplevel:pm5);
	}
	$int0 = 1;
}
def_int $int4 = 0;
def_int $chattype5 = ^chattype_gamemessage;
if (%var287 = 1) {
	while ($int4 < 100 & $int0 < 5) {
		if (~script91($int4) = 1) {
			$component1 = enum(int, component, enum_580, $int0);
			$chattype5 = chat_gethistory_byuid($int4);
			if ($chattype5 = ^chattype_privatechat) {
				if_settext("From <chat_gethistory_username($int4)>: <chat_gethistory_bytypeandline($int4)>", $component1);
			}
			if ($chattype5 = ^chattype_loginlogoutnotification) {
				if_settext(chat_gethistory_bytypeandline($int4), $component1);
			}
			if ($chattype5 = ^chattype_privatechatout) {
				if_settext("To <chat_gethistory_username($int4)>: <chat_gethistory_bytypeandline($int4)>", $component1);
			}
			if ($chattype5 = ^chattype_modprivatechat) {
				if_settext("From <chat_gethistory_username($int4)>: <chat_gethistory_bytypeandline($int4)>", $component1);
			}
			if ($chattype5 = 18) {
				if_settext("From <chat_gethistory_username($int4)>: <chat_gethistory_bytypeandline($int4)>", $component1);
			}
			if ($chattype5 = 19) {
				if_settext("To <chat_gethistory_username($int4)>: <chat_gethistory_bytypeandline($int4)>", $component1);
			}
			if ($chattype5 = ^chattype_privatechat | $chattype5 = ^chattype_modprivatechat | $chattype5 = 18 | $chattype5 = 19) {
				if_setopbase("<col=ffffff><chat_gethistory_username($int4)>", $component1);
				if_setop(8, "Add friend", $component1);
				if_setop(9, "Add ignore", $component1);
				if (staffmodlevel > 0 | playermod > false) {
					if_setop(10, "Report abuse", $component1);
				} else {
					if_setop(10, "", $component1);
				}
			} else {
				if_setop(8, "", $component1);
				if_setop(9, "", $component1);
				if_setop(10, "", $component1);
			}
			$int0 = calc($int0 + 1);
		}
		$int4 = calc($int4 + 1);
	}
}
while ($int0 < 5) {
	$component1 = enum(int, component, enum_580, $int0);
	if_settext("", $component1);
	if_setop(8, "", $component1);
	if_setop(9, "", $component1);
	if_setop(10, "", $component1);
	$int0 = calc($int0 + 1);
}
