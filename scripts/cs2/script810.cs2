// 810
[proc,script810]
if (map_members = ^true & %varbit_4280 = 1) {
	if_sethide(false, toplevel:topstat_background_lore);
	if_sethide(false, toplevel:topstat_circle_lore);
	if_sethide(false, toplevel:topstat_graphic_lore);
	if_sethide(false, toplevel:109);
	~script817(summoning);
	if_sethide(false, toplevel:110);
	if_setcolour(~script805(summoning), toplevel:110);
	if_settext(tostring(stat(summoning)), toplevel:110);
} else {
	if_sethide(true, toplevel:topstat_background_lore);
	if_sethide(true, toplevel:topstat_circle_lore);
	if_sethide(true, toplevel:110);
	if_sethide(true, toplevel:topstat_graphic_lore);
	if_sethide(true, toplevel:109);
}
