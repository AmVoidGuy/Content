// 579
[clientscript,script579](int $int0, obj $obj1)
if (cc_find(objdialog:resultlist, 0) = ^true) {
	cc_setposition(0, calc(15 * ($int0 - 1)));
	cc_setsize(if_getwidth(objdialog:resultlist), 15);
	cc_setcolour(^black);
	cc_settrans(220);
	cc_setfill(true);
}
if_setobject($obj1, -1, objdialog:objgraphic);
