// 679
[proc,script679](component $component0)
cc_deleteall($component0);
def_int $width1 = if_getwidth($component0);
def_int $height2 = if_getheight($component0);
def_int $x3 = calc($width1 - 9);
def_int $y4 = calc($height2 - 9);
def_int $width5 = calc($width1 - 18);
def_int $height6 = calc($height2 - 18);
~script98($component0, 0, "v2_stone_button_0", 0, 0, 9, 9);
~script98($component0, 1, "v2_stone_button_1", $x3, 0, 9, 9);
~script98($component0, 2, "v2_stone_button_2", 0, $y4, 9, 9);
~script98($component0, 3, "v2_stone_button_3", $x3, $y4, 9, 9);
~script98($component0, 4, "v2_stone_button_4", 0, 9, 9, $height6);
~script98($component0, 5, "v2_stone_button_5", 9, 0, $width5, 9);
~script98($component0, 6, "v2_stone_button_6", $x3, 9, 9, $height6);
~script98($component0, 7, "v2_stone_button_7", 9, $y4, $width5, 9);
