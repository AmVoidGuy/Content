// 911
[clientscript,script911]
if (%varbit_4532 = 1 & %varcint118 < 253) {
	%varcint118 = calc(%varcint118 + 3);
	if_settrans(calc(255 - %varcint118), easter08_chocatrice_hatching:blackout_rect);
} else if (%varbit_4532 = 0 & %varcint118 > 3) {
	%varcint118 = calc(%varcint118 - 3);
	if_settrans(calc(255 - %varcint118), easter08_chocatrice_hatching:blackout_rect);
}
