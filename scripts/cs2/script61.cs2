// 61
[clientscript,script61]
def_int $int0 = 0;
while ($int0 < 5) {
	cc_create(dream_armour:chest_layer, ^iftype_graphic, $int0);
	cc_setsize(36, 32);
	if ($int0 = 0) {
		cc_setposition(0, 43);
	}
	if ($int0 = 1) {
		cc_setposition(50, 2);
	}
	if ($int0 = 2) {
		cc_setposition(50, 43);
	}
	if ($int0 = 3) {
		cc_setposition(50, 85);
	}
	if ($int0 = 4) {
		cc_setposition(50, 125);
	}
	if (inv_getobj(dream_crate_inventory, $int0) ! null) {
		cc_setobject(inv_getobj(dream_crate_inventory, $int0), inv_getnum(dream_crate_inventory, $int0));
		cc_setopbase(oc_name(inv_getobj(dream_crate_inventory, $int0)));
		cc_setop(1, "Deposit");
		cc_setgraphicshadow(0x111111);
		cc_setoutline(1);
		if ($int0 = 0) {
			if_setgraphic(null, dream_armour:inv_icon_weapon);
		}
		if ($int0 = 1) {
			if_setgraphic(null, dream_armour:inv_icon_helm);
		}
		if ($int0 = 2) {
			if_setgraphic(null, dream_armour:inv_icon_chest);
		}
		if ($int0 = 3) {
			if_setgraphic(null, dream_armour:inv_icon_leggings);
		}
		if ($int0 = 4) {
			if_setgraphic(null, dream_armour:inv_icon_boots);
		}
	} else {
		if ($int0 = 0) {
			if_setgraphic("wornicons_3", dream_armour:inv_icon_weapon);
		}
		if ($int0 = 1) {
			if_setgraphic("wornicons_0", dream_armour:inv_icon_helm);
		}
		if ($int0 = 2) {
			if_setgraphic("wornicons_5", dream_armour:inv_icon_chest);
		}
		if ($int0 = 3) {
			if_setgraphic("wornicons_7", dream_armour:inv_icon_leggings);
		}
		if ($int0 = 4) {
			if_setgraphic("wornicons_9", dream_armour:inv_icon_boots);
		}
	}
	$int0 = calc($int0 + 1);
}
