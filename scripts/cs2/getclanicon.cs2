// 198
[proc,getclanicon](int $rank0)(graphic)
switch_int ($rank0) {
	case 0 :
		return("clan_chat_icons_0");
	case 1 :
		return("clan_chat_icons_8");
	case 2 :
		return("clan_chat_icons_7");
	case 3 :
		return("clan_chat_icons_6");
	case 4 :
		return("clan_chat_icons_5");
	case 5 :
		return("clan_chat_icons_4");
	case 6 :
		return("clan_chat_icons_3");
	case 7 :
		return("clan_chat_icons_2");
	case 127 :
		return("clan_chat_icons_1");
	case default :
		return(null);
}
