// 555
[clientscript,script555]
def_int $y0 = calc((15 - %varbit_4109) * 6);
if_setposition(0, $y0, lotg_fairy_ring_power_interface:meter_1);
if_settext(tostring(%varbit_4109), lotg_fairy_ring_power_interface:counter1);
$y0 = calc((15 - %varbit_4110) * 6);
if_setposition(0, $y0, lotg_fairy_ring_power_interface:meter_2);
if_settext(tostring(%varbit_4110), lotg_fairy_ring_power_interface:counter2);
$y0 = calc((15 - %varbit_4111) * 6);
if_setposition(0, $y0, lotg_fairy_ring_power_interface:meter_3);
if_settext(tostring(%varbit_4111), lotg_fairy_ring_power_interface:counter3);
