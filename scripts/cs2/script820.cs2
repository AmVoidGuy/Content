// 820
[clientscript,script820]
if (%varbit_4286 ! 101) {
	if_settext("<tostring(%varbit_4286)>%", lore_cats_side:hunger);
	if (%varbit_4286 > 74) {
		if_setcolour(^red, lore_cats_side:hunger);
	} else {
		if_setcolour(^white, lore_cats_side:hunger);
	}
} else {
	if_settext("NA", lore_cats_side:hunger);
}
if (%varbit_4285 ! 101) {
	if_settext("<tostring(%varbit_4285)>%", lore_cats_side:size_percentage);
} else {
	if_settext("NA", lore_cats_side:size_percentage);
}
