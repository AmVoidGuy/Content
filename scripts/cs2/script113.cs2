// 113
[proc,script113]
if (if_hassub(toplevel:chatmodallarge) = true) {
	if_sethide(false, toplevel:chatmodallarge);
	if_sethide(true, toplevel:chatmodal);
	if_sethide(true, toplevel:chatoverlaylarge);
	if_sethide(true, toplevel:chatoverlay);
	if_sethide(true, toplevel:chatdefault);
} else if (if_hassub(toplevel:chatmodal) = true) {
	if_sethide(true, toplevel:chatmodallarge);
	if_sethide(false, toplevel:chatmodal);
	if_sethide(true, toplevel:chatoverlaylarge);
	if_sethide(true, toplevel:chatoverlay);
	if_sethide(true, toplevel:chatdefault);
} else if (if_hassub(toplevel:chatoverlaylarge) = true) {
	if_sethide(true, toplevel:chatmodallarge);
	if_sethide(true, toplevel:chatmodal);
	if_sethide(false, toplevel:chatoverlaylarge);
	if_sethide(true, toplevel:chatoverlay);
	if_sethide(true, toplevel:chatdefault);
} else if (if_hassub(toplevel:chatoverlay) = true) {
	if_sethide(true, toplevel:chatmodallarge);
	if_sethide(true, toplevel:chatmodal);
	if_sethide(true, toplevel:chatoverlaylarge);
	if_sethide(false, toplevel:chatoverlay);
	if_sethide(true, toplevel:chatdefault);
} else if (if_hassub(toplevel:chatdefault) = true) {
	if_sethide(true, toplevel:chatmodallarge);
	if_sethide(true, toplevel:chatmodal);
	if_sethide(true, toplevel:chatoverlaylarge);
	if_sethide(true, toplevel:chatoverlay);
	if_sethide(false, toplevel:chatdefault);
}
