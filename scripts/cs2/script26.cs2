// 26
[clientscript,script26]
def_int $size0 = 0;
def_int $int1 = 0;
def_int $int2 = 25;
def_int $int3 = 20;
def_int $int4 = 0;
def_int $int5 = 0;
def_int $int6 = 0;
$int4 = calc((if_getwidth(magictraining_shop:shop_items_layer) - $int2) / ($int2 + 36));
while ($size0 <= inv_size(magictraining_inventory)) {
	cc_create(magictraining_shop:shop_items_layer, ^iftype_graphic, $size0);
	cc_setsize(36, 32);
	cc_setposition(calc($int2 + (36 + $int2) * ($size0 - $int1 * $int4)), calc($int3 + $int1 * (32 + $int3)));
	$int5 = calc($int2 + (36 + $int2) * ($size0 - $int1 * $int4));
	$int6 = calc($int3 + $int1 * (32 + $int3));
	if (inv_getobj(magictraining_inventory, $size0) ! null) {
		if (inv_getobj(magictraining_inventory, $size0) = magictraining_wand_appr_6910) {
			if_setposition(calc($int5 - 8), calc($int6 + 94), magictraining_shop:magictraining_shop_upgrade1);
		}
		if (inv_getobj(magictraining_inventory, $size0) = magictraining_wand_teach_6912) {
			if_setposition(calc($int5 - 8), calc($int6 + 94), magictraining_shop:magictraining_shop_upgrade2);
		}
		if (inv_getobj(magictraining_inventory, $size0) = magictraining_wand_master_6914) {
			if_setposition(calc($int5 - 8), calc($int6 + 94), magictraining_shop:magictraining_shop_upgrade3);
		}
		cc_setobject(inv_getobj(magictraining_inventory, $size0), inv_getnum(magictraining_inventory, $size0));
		cc_setgraphicshadow(^black);
		cc_setopbase("<col=ff9040><oc_name(inv_getobj(magictraining_inventory, $size0))>");
		cc_setoutline(1);
		cc_setop(1, "Value");
		cc_setop(2, "Buy");
		cc_setop(10, "Examine");
	}
	$size0 = calc($size0 + 1);
	if (calc($size0 % $int4) = 0) {
		$int1 = calc($int1 + 1);
	}
}
