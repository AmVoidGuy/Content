// 832
[clientscript,script832]
def_int $int0 = 0;
def_int $int1 = 0;
while ($int0 <= 614) {
	if (cc_find(music_v3:jukebox, $int0) = ^true) {
		if (~script837($int0) = 1) {
			cc_setcolour(^green);
			$int1 = calc($int1 + 1);
		} else {
			cc_setcolour(^red);
		}
	}
	$int0 = calc($int0 + 1);
}
if_settext("Unlocked:<br><tostring($int1)>", music_v3:unlock_counter);
