[proc,multiply2](int $int1, int $int2, int $m)(int, int)
$int1 = multiply($int1, $m);
$int2 = multiply($int2, $m);
return($int1, $int2);

[proc,add2](int $int1, int $int2, int $a)(int, int)
$int1 = add($int1, $a);
$int2 = add($int2, $a);
return($int1, $int2);

[proc,sub2](int $int1, int $int2, int $s)(int, int)
$int1 = sub($int1, $s);
$int2 = sub($int2, $s);
return($int1, $int2);

[proc,divide2](int $int1, int $int2, int $d)(int, int)
$int1 = divide($int1, $d);
$int2 = divide($int2, $d);
return($int1, $int2);

[proc,not_bool](int $bool)(int)
if ($bool = ^true) {
    return (^false);
}
return (^true);
