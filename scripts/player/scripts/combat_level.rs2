[proc,player_combat_level]()(int)
def_int $base = multiply(10, divide(add(add(stat_base(defence), stat_base(hitpoints)), stat_base(prayer)), 2));
def_int $melee = multiply(13, add(stat_base(attack), stat_base(strength)));
def_int $ranged = multiply(13, scale(3, 2, stat_base(ranged)));
def_int $magic = multiply(13, scale(3, 2, stat_base(magic)));

//mes("Base: <tostring($base)>, Melee: <tostring($melee)>, Ranged: <tostring($ranged)>, Magic: <tostring($magic)>");

def_int $final = divide(add($base, max(max($melee, $ranged), $magic)),40);
return($final);

[proc,.player_combat_level]()(int)
def_int $base = multiply(10, divide(add(add(.stat_base(defence), .stat_base(hitpoints)), .stat_base(prayer)), 2));
def_int $melee = multiply(13, add(.stat_base(attack), .stat_base(strength)));
def_int $ranged = multiply(13, scale(3, 2, .stat_base(ranged)));
def_int $magic = multiply(13, scale(3, 2, .stat_base(magic)));

//mes("Base: <tostring($base)>, Melee: <tostring($melee)>, Ranged: <tostring($ranged)>, Magic: <tostring($magic)>");

def_int $final = divide(add($base, max(max($melee, $ranged), $magic)),40);
return($final);
