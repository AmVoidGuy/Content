[debugproc,lineofwalk]
def_int $lineOfWalkWest = lineofwalk(coord, movecoord(coord, -1, 0, 0));
def_int $lineOfWalkEast = lineofwalk(coord, movecoord(coord, 1, 0, 0));
def_int $lineOfWalkNorth = lineofwalk(coord, movecoord(coord, 0, 0, 1));
def_int $lineOfWalkSouth = lineofwalk(coord, movecoord(coord, 0, 0, -1));

if ($lineOfWalkWest = ^true) {
    mes("Line of Walk: West Free");
}

if ($lineOfWalkEast = ^true) {
    mes("Line of Walk: East Free");
}

if ($lineOfWalkNorth = ^true) {
    mes("Line of Walk: North Free");
}

if ($lineOfWalkSouth = ^true) {
    mes("Line of Walk: South Free");
}
