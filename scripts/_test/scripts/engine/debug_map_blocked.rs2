[debugproc,map_blocked]
def_int $west = map_blocked(movecoord(coord, -1, 0, 0));
def_int $east = map_blocked(movecoord(coord, 1, 0, 0));
def_int $north = map_blocked(movecoord(coord, 0, 0, 1));
def_int $south = map_blocked(movecoord(coord, 0, 0, -1));

if ($west = ^false) {
    mes("Map Blocked: West Free");
}

if ($east = ^false) {
    mes("Map Blocked: East Free");
}

if ($north = ^false) {
    mes("Map Blocked: North Free");
}

if ($south = ^false) {
    mes("Map Blocked: South Free");
}
