[debugproc,west](int $distance)//Direction teleport west
if_close;
if (p_finduid(uid) = ^true) {
    p_teleport(movecoord(coord, calc(0 - max($distance, 1)), 0, 0));
    return;
}
@please_finish;

[debugproc,east](int $distance)//Direction teleport east
if_close;
if (p_finduid(uid) = ^true) {
    p_teleport(movecoord(coord, max($distance, 1), 0, 0));
    return;
}
@please_finish;

[debugproc,north](int $distance)//Direction teleport north
if_close;
if (p_finduid(uid) = ^true) {
    p_teleport(movecoord(coord, 0, 0, max($distance, 1)));
    return;
}
@please_finish;

[debugproc,south](int $distance)//Direction teleport south
if_close;
if (p_finduid(uid) = ^true) {
    p_teleport(movecoord(coord, 0, 0, calc(0 - max($distance, 1))));
    return;
}
@please_finish;

[debugproc,home]//Lumby
if_close;
if (p_finduid(uid) = ^true) {
    ~player_teleport_normal(0_50_50_22_22);
    return;
}
@please_finish;

